# Copy to .env and replace placeholders before starting the stack.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=172800000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-your-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-web-client-secret